# ---- LLM (optional) -----------------------------------------------------
# heuristic (default, deterministic, no network) | anthropic | openai
LLM_PROVIDER=heuristic
# Optional model override. Defaults: anthropic=claude-opus-5-5, openai=gpt-4.1
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60

# ---- DataSentinel -------------------------------------------------------
# Root for data/, artifacts/ and workspace/ (defaults to the repo root)
# DATASENTINEL_HOME=
# Where the monitored pipeline git repo is created (defaults to $DATASENTINEL_HOME/workspace)
# DATASENTINEL_WORKSPACE_DIR=
DATASENTINEL_DEFAULT_ROWS=110000
DATASENTINEL_DEFAULT_SEED=42
# Detection thresholds can be overridden as JSON, e.g.
# DATASENTINEL_THRESHOLDS={"row_count_warning": 0.1, "row_count_critical": 0.25}

# ---- Frontend (frontend/.env.local) ---------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
